     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Fraud cases : 821\n",
      "Total       : 636,262\n",
      "Fraud rate  : 0.1290%\n",
      "\n",
      "A 'predict never-fraud' model would score 99.87% accuracy — and catch ZERO fraud.\n"
     ]
    }
   ],
   "source": [
    "fraud_rate = df['isFraud'].mean()\n",
    "print(f\"Fraud cases : {df['isFraud'].sum():,}\")\n",
    "print(f\"Total       : {len(df):,}\")\n",
    "print(f\"Fraud rate  : {fraud_rate*100:.4f}%\")\n",
    "print(f\"\\nA 'predict never-fraud' model would score {(1-fraud_rate)*100:.2f}% accuracy — and catch ZERO fraud.\")"
   ]
